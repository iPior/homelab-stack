{
  "uid": "homelab-overview",
  "title": "Homelab Overview",
  "description": "Exporter status, Linux host health, and Docker container usage.",
  "tags": [
    "homelab",
    "observability"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=~\"node-exporter|cadvisor\"}, instance)",
        "query": {
          "query": "label_values(up{job=~\"node-exporter|cadvisor\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"node-exporter|cadvisor\",instance=~\"${host:regex}\"}",
          "legendFormat": "{{instance}} / {{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down"
                },
                "1": {
                  "text": "Up"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Host CPU utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node-exporter\",instance=~\"${host:regex}\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Available host memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"node-exporter\",instance=~\"${host:regex}\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Filesystem space free",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_filesystem_avail_bytes{job=\"node-exporter\",instance=~\"${host:regex}\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|ramfs|nsfs\"} / (node_filesystem_size_bytes{job=\"node-exporter\",instance=~\"${host:regex}\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|ramfs|nsfs\"} > 0)",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Percentage available to non-root users on each filesystem."
    },
    {
      "id": 5,
      "title": "Host network traffic",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=\"node-exporter\",instance=~\"${host:regex}\",device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} receive",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{job=\"node-exporter\",instance=~\"${host:regex}\",device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} transmit",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Sum across interfaces, excluding loopback, Docker bridges, and virtual Ethernet pairs."
    },
    {
      "id": 6,
      "title": "Top containers by CPU",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (instance, name) ((rate(container_cpu_usage_seconds_total{job=\"cadvisor\",instance=~\"${host:regex}\",name!=\"\"}[$__rate_interval])) or label_replace((rate(container_cpu_usage_seconds_total{job=\"cadvisor\",instance=~\"${host:regex}\",name=\"\",id=~\"(.*docker-|/docker/)[0-9a-f]{64}([.]scope)?\"}[$__rate_interval])) unless on (instance, id) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",instance=~\"${host:regex}\",name!=\"\"}[$__rate_interval])), \"name\", \"$2\", \"id\", \"(.*docker-|/docker/)([0-9a-f]{12}).*\")))",
          "legendFormat": "{{instance}} / {{name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "suffix: cores",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "A value of 1 core means one logical CPU was fully utilized over the query interval. Uses the short Docker ID when cAdvisor has no container name."
    },
    {
      "id": 7,
      "title": "Top containers by memory",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (instance, name) ((container_memory_working_set_bytes{job=\"cadvisor\",instance=~\"${host:regex}\",name!=\"\"}) or label_replace((container_memory_working_set_bytes{job=\"cadvisor\",instance=~\"${host:regex}\",name=\"\",id=~\"(.*docker-|/docker/)[0-9a-f]{64}([.]scope)?\"}) unless on (instance, id) (container_memory_working_set_bytes{job=\"cadvisor\",instance=~\"${host:regex}\",name!=\"\"}), \"name\", \"$2\", \"id\", \"(.*docker-|/docker/)([0-9a-f]{12}).*\")))",
          "legendFormat": "{{instance}} / {{name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Current memory working set. Uses the short Docker ID when cAdvisor has no container name."
    }
  ]
}
